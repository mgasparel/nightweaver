{
  "uid": "nightweaver-first-path",
  "title": "Nightweaver - delivery bottlenecks",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "tags": [
    "nightweaver",
    "observation-only"
  ],
  "description": "Observed slot-seconds are disjoint per reservation, additive across parallel slots, never wall-clock lead time. Unknown is not zero. Metrics unsampled; details sampled/dropped. Free retention: 14 days. Hosted acceptance pending. See docs/design/grafana-bottlenecks.md.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "DS_METRICS",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "refresh": 1
      },
      {
        "name": "DS_TEMPO",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {
          "text": "Tempo",
          "value": "tempo"
        },
        "refresh": 1
      },
      {
        "name": "DS_LOKI",
        "label": "Events",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "loki"
        },
        "refresh": 1
      },
      {
        "name": "bead",
        "label": "bead ID (details)",
        "type": "textbox",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": []
      },
      {
        "name": "runtime",
        "label": "runtime ID (details)",
        "type": "textbox",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": []
      },
      {
        "name": "invocation",
        "label": "invocation ID (details)",
        "type": "textbox",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Explore correlated traces",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22%3A%22${DS_TEMPO}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22nightweaver-runtime%5C%22%20%26%26%20span.bead.id%20%3D~%20%5C%22$bead%5C%22%20%26%26%20span.runtime.id%20%3D~%20%5C%22$runtime%5C%22%20%26%26%20span.invocation.id%20%3D~%20%5C%22$invocation%5C%22%20%7D%22%2C%22expr%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22nightweaver-runtime%5C%22%20%26%26%20span.bead.id%20%3D~%20%5C%22$bead%5C%22%20%26%26%20span.runtime.id%20%3D~%20%5C%22$runtime%5C%22%20%26%26%20span.invocation.id%20%3D~%20%5C%22$invocation%5C%22%20%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D",
      "targetBlank": false
    },
    {
      "title": "Explore verified events",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22%3A%22${DS_LOKI}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7Bservice_name%3D%5C%22nightweaver-runtime%5C%22%7D%20%7C%20operation%3D%5C%22verified_merge%5C%22%20%7C%20bead_id%3D~%5C%22$bead%5C%22%20%7C%20runtime_id%3D~%5C%22$runtime%5C%22%20%7C%20invocation_id%3D~%5C%22$invocation%5C%22%22%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22nightweaver-runtime%5C%22%7D%20%7C%20operation%3D%5C%22verified_merge%5C%22%20%7C%20bead_id%3D~%5C%22$bead%5C%22%20%7C%20runtime_id%3D~%5C%22$runtime%5C%22%20%7C%20invocation_id%3D~%5C%22$invocation%5C%22%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Observed invocation duration",
      "description": "Mean seconds by role, rate(sum)/rate(count). Resets handled per series before aggregation; no complete samples means unknown.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(role) (rate(nightweaver_invocation_duration_seconds_sum[$__rate_interval])) / sum by(role) (rate(nightweaver_invocation_duration_seconds_count[$__rate_interval]))",
          "instant": true,
          "legendFormat": "{{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Confirmed verified merges",
      "description": "Window increase of independently verified guarded closures. Extrapolated across scrapes, reset aware; export loss is possible. Cleanup never subtracts success.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nightweaver_verified_merge_total[$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Post-closure cleanup",
      "description": "Window increase by outcome, reset aware. Queued is not completed; housekeeping is independent of closure.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(outcome) (increase(nightweaver_merge_cleanup_total[$__range]))",
          "instant": true,
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Lifecycle events - operational IDs",
      "gridPos": {
        "x": 0,
        "y": 89,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"nightweaver-runtime\"} | bead_id=~\"$bead\" | runtime_id=~\"$runtime\" | invocation_id=~\"$invocation\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Short traces - invocation and closure",
      "gridPos": {
        "x": 0,
        "y": 98,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "query": "{ resource.service.name = \"nightweaver-runtime\" && span.bead.id =~ \"$bead\" && span.runtime.id =~ \"$runtime\" && span.invocation.id =~ \"$invocation\" }",
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Occupied time allocation",
      "description": "Completed reservation slot-seconds per second. Seven disjoint phases include coarse preparation/finalization; active work appears on release. Parallel slot-seconds are not wall time.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pool,phase) (rate(nightweaver_phase_seconds_total[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool}} / {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Live occupied / configured capacity",
      "description": "Live owned reservations / configured slots, including preparation and settlement. Missing exporter is unknown.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pool) (nightweaver_pool_occupied) / sum by(pool) (nightweaver_pool_capacity)",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Observed eligible queue",
      "description": "Fresh complete observed eligibility only. Excludes blocked, paused, reserved and backpressured work. Absence is unknown, never zero.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nightweaver_pool_queued and on(pool,job,instance) ((nightweaver_pool_fresh == 1) and on(pool,job,instance) (nightweaver_pool_coverage == 1))",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Oldest observed eligible wait",
      "description": "Age from first observed eligibility; 30-second discovery quantization plus read latency. Not total backlog age. Fresh and complete only.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nightweaver_pool_oldest_seconds and on(pool,job,instance) ((nightweaver_pool_fresh == 1) and on(pool,job,instance) (nightweaver_pool_coverage == 1))",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Queue freshness and coverage",
      "description": "Fresh and coverage must both be 1 for queue panels. Backpressure is the separate Planning gate. Missing stream is unknown.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"nightweaver_pool_(fresh|coverage|backpressure)\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool}} / {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Queue observation age",
      "description": "Seconds since successful observation; >60 seconds invalidates waiting coverage. Initial unavailable has no age.",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nightweaver_pool_age_seconds",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Completed observed eligible waits",
      "description": "Mean complete continuously observed intervals to reservation. Left-censored startup/restart and failed reads are excluded.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pool) (rate(nightweaver_eligible_wait_duration_seconds_sum[$__rate_interval])) / sum by(pool) (rate(nightweaver_eligible_wait_duration_seconds_count[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Lost waiting coverage",
      "description": "Diagnostic censor observations, not unique Beads. Capacity refusals may repeat counts.",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pool,reason) (increase(nightweaver_eligible_wait_censored_total[$__range]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool}} / {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Invocation outcomes",
      "description": "Unsampled settled attempts. Timeout/retry does not imply semantic repair or approval.",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(role,status) (increase(nightweaver_invocation_attempts_total[$__range]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{role}} / {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Classifier and verification diagnostics",
      "description": "Diagnostic results include classification, verification and publication. Classifier success is not work approval; diagnostic durations overlap phases.",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(kind,outcome) (increase(nightweaver_workflow_results_total[$__range]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{kind}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Operational retries",
      "description": "Operational retry observations, distinct from semantic repairs. Reset aware window increase.",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(reason) (increase(nightweaver_operational_retries_total[$__range]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Semantic repairs",
      "description": "Confirmed ChangesRequired publications only; not classifier diagnostics or operational retries.",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(role) (increase(nightweaver_semantic_repairs_total[$__range]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Known-history first-pass approvals",
      "description": "FirstPass / (FirstPass + LaterPass) approvals. Unknown excluded and shown alongside. Repeated attempts also make LaterPass.",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "targets": [
        {
          "refId": "A",
