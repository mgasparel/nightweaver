<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Nightweaver.Tests</RootNamespace>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <ProjectReference Include="../../src/Nightweaver.Web/Nightweaver.Web.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="../../src/Nightweaver/Nightweaver.csproj" />
    <ProjectReference Include="../AgentInvocationFixture/AgentInvocationFixture.csproj" />
    <ProjectReference Include="../ExecutionCrashHost/ExecutionCrashHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NightweaverAppDir" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/Nightweaver/bin/$(Configuration)/net10.0'))" />
    <AssemblyMetadata Include="NightweaverWebAppDir" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/Nightweaver.Web/bin/$(Configuration)/net10.0'))" />
  </ItemGroup>
</Project>
